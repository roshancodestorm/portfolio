# ── Firebase (frontend-safe config, NOT secret) ─────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Server-side secrets (NEVER expose in frontend) ──────────────────────────
# Consumed by secure serverless functions (see /api). Keep these out of .env
# files that ship to the browser, and NEVER add a VITE_ prefix to secrets.
AI_API_KEY=
REMOVE_BG_API_KEY=

# ── GitHub activity (server-side) ───────────────────────────────────────────
# Set these in Netlify → Site configuration → Environment variables.
# GITHUB_TOKEN is a fine-grained personal access token with read access to
# public repositories. It powers the GraphQL contributionsCollection heatmap
# and raises the REST rate limit. Without it, REST falls back to anonymous
# public endpoints and the heatmap shows an explicit unavailable state.
# GITHUB_TOKEN=
# GITHUB_USERNAME=roshancodestorm

# ── Site links / public endpoints ───────────────────────────────────────────
VITE_AI_CHAT_ENDPOINT=/api/chat
VITE_REMOVE_BG_ENDPOINT=/api/remove-background
VITE_GITHUB_REST_ENDPOINT=/api/github-rest
VITE_GITHUB_GRAPHQL_ENDPOINT=/api/github-graphql
VITE_GOOGLE_FORM_URL=
VITE_RESUME_URL=/resume.pdf
