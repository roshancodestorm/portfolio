# ── Firebase (frontend-safe config, NOT secret) ─────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Server-side secrets (NEVER expose in frontend) ──────────────────────────
# Consumed by a secure serverless backend (see /api). Keep these out of .env
# files that ship to the browser.
AI_API_KEY=
REMOVE_BG_API_KEY=

# ── Site links ──────────────────────────────────────────────────────────────
VITE_AI_CHAT_ENDPOINT=/api/chat
VITE_REMOVE_BG_ENDPOINT=/api/remove-background
VITE_GOOGLE_FORM_URL=
VITE_RESUME_URL=/resume.pdf